<?xml version="1.0" encoding="UTF-8"?>
<!-- This comment is only here because changes to resources are not picked up
     without changes to the corresponding grd file.  -->
<grit latest_public_release="0" current_release="1" output_all_resource_defines="false">
  <outputs>
    <output filename="grit/component_extension_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/component_extension_resources_map.cc" type="resource_file_map_source" />
    <output filename="grit/component_extension_resources_map.h" type="resource_map_header" />
    <output filename="component_extension_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NETWORK_SPEECH_SYNTHESIS_JS" file="extensions/network_speech_synthesis/tts_extension.js" type="BINDATA" />
      <include name="IDS_READING_MODE_DEFAULT_PNG" file="extensions/side_panel/read_anything/images/read_anything_default.png" type="BINDATA" />
      <include name="IDS_READING_MODE_LIGHT_PNG" file="extensions/side_panel/read_anything/images/read_anything_light.png" type="BINDATA" />
      <include name="IDS_READING_MODE_DARK_PNG" file="extensions/side_panel/read_anything/images/read_anything_dark.png" type="BINDATA" />
      <include name="IDS_READING_MODE_YELLOW_PNG" file="extensions/side_panel/read_anything/images/read_anything_yellow.png" type="BINDATA" />
      <include name="IDS_READING_MODE_BLUE_PNG" file="extensions/side_panel/read_anything/images/read_anything_blue.png" type="BINDATA" />
    </includes>
  </release>
</grit>
